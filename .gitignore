# build output
dist/
# generated types
.astro/
# generated from wrangler.jsonc by `wrangler types`; regenerate, don't commit
worker-configuration.d.ts

# Cloudflare Workers local dev/deploy state
.wrangler/

# test artifacts
coverage/
playwright-report/
test-results/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.*
!.env.example

# Worker secrets for local development (wrangler and the Cloudflare plugin read them): never
# commit real values. The example file and the hermetic e2e values are the tracked exceptions.
.dev.vars
.dev.vars.*
!.dev.vars.example
!.dev.vars.e2e

# macOS-specific files
.DS_Store

# editor folders
.idea/

# local content sources (CV, LinkedIn export): never commit
/*.pdf

# local agent tooling
.codegraph/
.atl/

# Lighthouse CI: .lighthouseci/ is LHCI's working folder (the collected runs), and
# lighthouse-reports/ is where the reports are written for the CI artifact. Both stay.
.lighthouseci/
lighthouse-reports/
