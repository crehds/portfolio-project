---
import type { ImageMetadata } from 'astro';
import { getEntry } from 'astro:content';
import { Font } from 'astro:assets';

import ogCardEn from '../assets/og/og-card-en.png';
import ogCardEs from '../assets/og/og-card-es.png';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import Link from '../components/Link.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import {
  canonicalHref,
  hreflangAlternates,
  localeOfPathname,
  pathnameInLocale,
  pathnameIsWithinSection,
  pathnamesMatch,
} from '../shared/i18n/paths';
import { getDictionary } from '../shared/i18n/ui';
import { NAV_ITEMS } from '../shared/nav/nav-items';
import { THEME_COLORS } from '../shared/theme/theme-color';
import { homeMetadata } from '../modules/profile/domain/home-metadata';
import type { Locale } from '../shared/i18n/locales';
import { buildSocialMeta } from '../shared/seo/social-meta';
import type { SocialImage } from '../shared/seo/social-meta';
import '../styles/global.css';

// Shared layout: skip link, header (site name, primary nav, language switcher, theme
// toggle), main and a profile-sourced footer. See T07 in odd/tasks/portfolio-astro-rebuild.md.
//
// The primary nav's list wraps (`flex-wrap`): five items, and the longer Spanish labels, do
// not fit one line at 320px (the narrowest width the site supports), and a list that cannot
// wrap makes the whole page scroll sideways. e2e/layout.spec.ts checks it at 320, 390 and 768.
interface Props {
  title: string;
  description: string;
  /**
   * Whether the page is an error page (the 404 pages). It has no translation of itself and
   * no address of its own to describe, so it renders no hreflang alternates, no canonical
   * link and no Open Graph or Twitter tags, and its language switcher links to the home
   * pages instead. It asks search engines not to index it (`noindex`): `/404` and
   * `/es/404/` answer 200 as plain assets, so they are reachable as ordinary pages.
   */
  errorPage?: boolean;
  /**
   * The picture that a link preview shows for the page (`og:image`), as plain data: where
   * it is served, its size and its alt text. `src` is an address on this site, root-relative
   * as `getImage` answers it, or absolute; the layout makes it absolute with `Astro.site`,
   * never with the address the page was reached on. A page without one writes no picture
   * tags and asks for the small card.
   */
  socialImage?: SocialImage;
  /**
   * The page's structured data, already serialized for a script (`serializeJsonLd`, which
   * escapes every `<`), written as it is into a `<script type="application/ld+json">`. A page
   * without any writes no script.
   */
  jsonLd?: string;
}

const {
  title,
  description,
  errorPage = false,
  socialImage,
  jsonLd,
} = Astro.props;

const pathname = Astro.url.pathname;
const locale = localeOfPathname(pathname);
const dictionary = getDictionary(locale);

if (!Astro.site) {
  throw new Error(
    'astro.config.mjs must set "site" so the canonical link and the hreflang alternates can be absolute URLs.',
  );
}

// Both come from `Astro.site`, never from the origin the request came in on, so a preview
// or a local server still points search engines at the production address.
const canonical = errorPage
  ? undefined
  : canonicalHref(pathname, Astro.site.href);
const alternates = errorPage
  ? []
  : hreflangAlternates(pathname, Astro.site.href);

const profile = await getEntry('profile', 'profile');
if (!profile) {
  throw new Error(
    'The "profile" content entry is missing; the footer needs it for the name and contact links.',
  );
}

// The default card of each locale (src/assets/og, drawn by scripts/social-card): the picture of
// a preview for every page without a picture of its own, such as a project's cover.
const DEFAULT_CARDS: Record<Locale, ImageMetadata> = {
  en: ogCardEn,
  es: ogCardEs,
};

// What a preview of a link to the page is drawn from. The tags name the canonical address, so
// the page that has none, an error page, has none of them either. The pictures are resolved
// against `Astro.site` like the canonical link: a preview fetches them from the address in the
// tag, which must not be a preview deployment's or a local server's. The default card is the
// file as it is (its `src`, not a converted copy), so the size and the type that it declares are
// the ones its metadata has; its alt text is the profile's name and role, which is what it shows.
let socialMeta: ReturnType<typeof buildSocialMeta> = [];
if (canonical !== undefined) {
  const card = DEFAULT_CARDS[locale];
  socialMeta = buildSocialMeta({
    locale,
    siteName: dictionary.siteTitle,
    title,
    description,
    url: canonical,
    image: socialImage && {
      ...socialImage,
      src: new URL(socialImage.src, Astro.site).href,
    },
    defaultImage: {
      src: new URL(card.src, Astro.site).href,
      width: card.width,
      height: card.height,
      type: `image/${card.format}`,
      alt: homeMetadata(profile.data, locale).title,
    },
  });
}
---

<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content={THEME_COLORS.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={THEME_COLORS.dark}
      media="(prefers-color-scheme: dark)"
    />
    {/* Icons (public/, scripts/icons). The .ico names its size so that Chrome, which would take an
      unsized .ico over the SVG, uses the SVG; the SVG is one picture for both color schemes. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Static, literal script (no server-interpolated values, so a future CSP hash for it
      // stays stable - T13): applies the theme before first paint so there is no flash of
      // the wrong theme, then keeps following the OS preference live while nothing is
      // stored (the legacy site did too; once the visitor picks a theme - see
      // ThemeToggle.astro's click handler, which persists it - a later OS change is
      // ignored). `isStoredTheme` mirrors the export of the same name in
      // `src/shared/theme/resolve-theme.ts`, which `resolveTheme` itself also uses for the
      // identical "stored preference wins, else the OS preference" order; this script cannot
      // import that module and stay static (a pre-paint script can't wait on a module
      // fetch), so keep both in sync by hand. Also removes `.no-js` (there is no positive
      // `.js` class to add - `global.css`'s `.no-js .theme-toggle` rule only needs that
      // class's absence to show the toggle again) so CSS stops hiding JS-only controls once
      // we know they will work.
      (function () {
        function isStoredTheme(value) {
          return value === 'light' || value === 'dark';
        }

        function readStoredTheme() {
          try {
            return localStorage.getItem('theme');
          } catch {
            // Private browsing / blocked storage: proceed as if nothing were stored.
            return null;
          }
        }

        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const stored = readStoredTheme();
        const theme = isStoredTheme(stored)
          ? stored
          : media.matches
            ? 'dark'
            : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.classList.remove('no-js');

        media.addEventListener('change', function (event) {
          if (isStoredTheme(readStoredTheme())) return;

          const nextTheme = event.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', nextTheme);
          document.documentElement.dispatchEvent(
            new CustomEvent('themechange'),
          );
        });
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {errorPage && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={alternate.href}
      />
    ))}
    {socialMeta.map((tag) => (
      <meta {...tag} />
    ))}
    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={jsonLd} />
    )}
    <Font
      cssVariable="--font-ubuntu"
      preload={[{ weight: '400' }, { weight: '700' }]}
    />
    <Font cssVariable="--font-ubuntu-mono" preload />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">
      {dictionary.skipLinkLabel}
    </a>
    <header class="border-b border-border bg-surface">
      <div class="mx-auto flex w-full max-w-4xl flex-wrap items-center justify-between gap-4 px-4 py-3">
        <a href={pathnameInLocale('/', locale)} class="font-bold text-text">
          {dictionary.siteTitle}
        </a>
        <nav aria-label={dictionary.primaryNavLabel}>
          <ul class="flex flex-wrap items-center gap-x-4 gap-y-1">
            {NAV_ITEMS.map((item) => {
              const href = item.href(locale);
              // An error page is no nav item's page or section. Prerendered, it is built for
              // `/404`, which matches none; rendered on demand (as `astro dev` does), it is
              // built for the address the visitor asked for, and a mistyped address under a
              // real section would mark that section.
              const isCurrentPage =
                !errorPage && pathnamesMatch(pathname, href);
              // A nested page (e.g. a project's own detail page) marks its top-level nav
              // item current too, just not as literally "the current page" - see
              // `pathnameIsWithinSection`.
              const isCurrentSection =
                !errorPage &&
                !isCurrentPage &&
                pathnameIsWithinSection(pathname, href);
              const ariaCurrent = isCurrentPage
                ? 'page'
                : isCurrentSection
                  ? 'true'
                  : undefined;
              // A visible marker, not just the ARIA attribute: `text-accent` reuses
              // the accent token already verified at AA contrast against this header's
              // `bg-surface` (see tokens.test.ts's "accent (links) on a surface panel"
              // case, >= 4.5:1 in both themes - comfortably over the 3:1 a border
              // needs too), and the bottom border repeats the cue for anyone who
              // perceives the color change less reliably than contrast alone. The
              // non-current branch reserves the same 2px transparent border so
              // switching pages never shifts neighboring items.
              const linkClass = ariaCurrent
                ? 'inline-block min-h-6 border-b-2 border-accent py-1 text-accent'
                : 'inline-block min-h-6 border-b-2 border-transparent py-1 text-text';
              return (
                <li>
                  <a href={href} aria-current={ariaCurrent} class={linkClass}>
                    {dictionary[item.labelKey]}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
        <div class="flex items-center gap-3">
          <LanguageSwitcher errorPage={errorPage} />
          <ThemeToggle />
        </div>
      </div>
    </header>
    <main
      id="main"
      tabindex="-1"
      class="mx-auto w-full max-w-4xl flex-1 px-4 py-8"
    >
      <!-- No blanket reading-width wrapper here (T08 follow-up): a page's own
           prose-like content applies its own `max-w-[70ch]`, so a wide element (e.g.
           the featured projects grid) can still use this full container instead of
           being force-clipped. This keeps the shared left/right edges (matching the
           header/footer above and below) on every child regardless of its own width. -->
      <slot />
    </main>
    <footer class="border-t border-border bg-surface">
      <div class="mx-auto flex w-full max-w-4xl flex-wrap items-center justify-between gap-4 px-4 py-6 text-sm text-text-muted">
        <p>{profile.data.name}</p>
        <ul class="flex items-center gap-4">
          <li>
            <Link href={profile.data.github} class="inline-block min-h-6 py-1">
              {dictionary.footerGithubLabel}
            </Link>
          </li>
          <li>
            <Link
              href={profile.data.linkedin}
              class="inline-block min-h-6 py-1"
            >
              {dictionary.footerLinkedinLabel}
            </Link>
          </li>
          <li>
            <a
              href={`mailto:${profile.data.email}`}
              class="inline-block min-h-6 py-1"
            >
              {dictionary.footerEmailLabel}
            </a>
          </li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Visually hidden until focused, then the first thing on the page: a sighted keyboard
     user tabs straight to it, activates it, and lands on `#main` without hearing/seeing
     every header link first. `top: -3rem` (not `sr-only`'s clip/position trick) keeps the
     transform-free, one-property change that `prefers-reduced-motion` below can disable. */
  .skip-link {
    position: absolute;
    top: -3rem;
    left: 1rem;
    z-index: 50;
    border-radius: 0.25rem;
    background-color: var(--color-surface);
    color: var(--color-accent);
    padding: 0.5rem 1rem;
    transition: top 0.2s ease-in-out;
  }

  .skip-link:focus {
    top: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition-duration: 0.01ms;
    }
  }
</style>
