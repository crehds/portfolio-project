---
import { getEntry } from 'astro:content';
import { Font } from 'astro:assets';

import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import {
  hreflangAlternates,
  localeOfPathname,
  pathnameInLocale,
} from '../shared/i18n/paths';
import { getDictionary } from '../shared/i18n/ui';
import { NAV_ITEMS } from '../shared/nav/nav-items';
import '../styles/global.css';

// Shared layout: skip link, header (site name, primary nav, language switcher, theme
// toggle), main and a profile-sourced footer. See T07 in odd/tasks/portfolio-astro-rebuild.md.
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const pathname = Astro.url.pathname;
const locale = localeOfPathname(pathname);
const dictionary = getDictionary(locale);

if (!Astro.site) {
  throw new Error(
    'astro.config.mjs must set "site" so hreflang alternates can be absolute URLs.',
  );
}

const alternates = hreflangAlternates(pathname, Astro.site.href);

const profile = await getEntry('profile', 'profile');
if (!profile) {
  throw new Error(
    'The "profile" content entry is missing; the footer needs it for the name and contact links.',
  );
}
---

<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Static, literal script (no server-interpolated values, so a future CSP hash for it
      // stays stable - T13): applies the theme before first paint so there is no flash of
      // the wrong theme, then keeps following the OS preference live while nothing is
      // stored (the legacy site did too; once the visitor picks a theme - see
      // ThemeToggle.astro's click handler, which persists it - a later OS change is
      // ignored). `isStoredTheme` mirrors the export of the same name in
      // `src/shared/theme/resolve-theme.ts`, which `resolveTheme` itself also uses for the
      // identical "stored preference wins, else the OS preference" order; this script cannot
      // import that module and stay static (a pre-paint script can't wait on a module
      // fetch), so keep both in sync by hand. Also removes `.no-js` (there is no positive
      // `.js` class to add - `global.css`'s `.no-js .theme-toggle` rule only needs that
      // class's absence to show the toggle again) so CSS stops hiding JS-only controls once
      // we know they will work.
      (function () {
        function isStoredTheme(value) {
          return value === 'light' || value === 'dark';
        }

        function readStoredTheme() {
          try {
            return localStorage.getItem('theme');
          } catch {
            // Private browsing / blocked storage: proceed as if nothing were stored.
            return null;
          }
        }

        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const stored = readStoredTheme();
        const theme = isStoredTheme(stored)
          ? stored
          : media.matches
            ? 'dark'
            : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.classList.remove('no-js');

        media.addEventListener('change', function (event) {
          if (isStoredTheme(readStoredTheme())) return;

          const nextTheme = event.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', nextTheme);
          document.documentElement.dispatchEvent(
            new CustomEvent('themechange'),
          );
        });
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={alternate.href}
      />
    ))}
    <Font cssVariable="--font-ubuntu" preload={[{ weight: '400' }]} />
    <Font cssVariable="--font-ubuntu-mono" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">
      {dictionary.skipLinkLabel}
    </a>
    <header class="border-b border-border bg-surface">
      <div class="mx-auto flex w-full max-w-4xl flex-wrap items-center justify-between gap-4 px-4 py-3">
        <a href={pathnameInLocale('/', locale)} class="font-bold text-text">
          {dictionary.siteTitle}
        </a>
        <nav aria-label={dictionary.primaryNavLabel}>
          <ul class="flex items-center gap-4">
            {NAV_ITEMS.map((item) => {
              const href = item.href(locale);
              const isCurrent = pathname === href;
              return (
                <li>
                  <a
                    href={href}
                    aria-current={isCurrent ? 'page' : undefined}
                    class="inline-block min-h-6 py-1 text-text"
                  >
                    {dictionary[item.labelKey]}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
        <div class="flex items-center gap-3">
          <LanguageSwitcher />
          <ThemeToggle />
        </div>
      </div>
    </header>
    <main
      id="main"
      tabindex="-1"
      class="mx-auto w-full max-w-[70ch] flex-1 px-4 py-8"
    >
      <slot />
    </main>
    <footer class="border-t border-border bg-surface">
      <div class="mx-auto flex w-full max-w-4xl flex-wrap items-center justify-between gap-4 px-4 py-6 text-sm text-text-muted">
        <p>{profile.data.name}</p>
        <ul class="flex items-center gap-4">
          <li>
            <a href={profile.data.github} class="inline-block min-h-6 py-1">
              {dictionary.footerGithubLabel}
            </a>
          </li>
          <li>
            <a href={profile.data.linkedin} class="inline-block min-h-6 py-1">
              {dictionary.footerLinkedinLabel}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${profile.data.email}`}
              class="inline-block min-h-6 py-1"
            >
              {dictionary.footerEmailLabel}
            </a>
          </li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Visually hidden until focused, then the first thing on the page: a sighted keyboard
     user tabs straight to it, activates it, and lands on `#main` without hearing/seeing
     every header link first. `top: -3rem` (not `sr-only`'s clip/position trick) keeps the
     transform-free, one-property change that `prefers-reduced-motion` below can disable. */
  .skip-link {
    position: absolute;
    top: -3rem;
    left: 1rem;
    z-index: 50;
    border-radius: 0.25rem;
    background-color: var(--color-surface);
    color: var(--color-accent);
    padding: 0.5rem 1rem;
    transition: top 0.2s ease-in-out;
  }

  .skip-link:focus {
    top: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition-duration: 0.01ms;
    }
  }
</style>
