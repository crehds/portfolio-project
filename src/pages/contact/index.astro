---
import ContactPage from '../../components/contact/ContactPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary } from '../../shared/i18n/ui';

// On demand, like `/cv/<locale>.pdf`: the contact form posts to this page, so it has to run
// on the Worker on every request. Every other page stays a static file.
export const prerender = false;

const dictionary = getDictionary('en');
---

<BaseLayout
  title={dictionary.contactPageTitle}
  description={dictionary.contactPageDescription}
>
  <ContactPage />
</BaseLayout>
