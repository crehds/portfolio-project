---
import type {
  DirectContactId,
  DirectContactLink,
} from '../../modules/profile/domain/direct-contact-links';
import { localeOfPathname } from '../../shared/i18n/paths';
import { getDictionary, type UiDictionary } from '../../shared/i18n/ui';
import { CONTACT_CTA_ICONS } from '../home/contact-cta-icons';
import Link from '../Link.astro';

// The ways to write without the form: WhatsApp and email. The contact page lists them
// beside the form, and the notices that take the form's place point to them. Presentational:
// the page root reads the profile and passes the links in (`directContactLinks`), so this
// renders from props alone. It shares `ContactCtas.astro`'s button style and icons.
// WhatsApp opens in a new tab (see `Link`); the `mailto:` link stays in this one.
interface Props {
  links: readonly DirectContactLink[];
}

const { links } = Astro.props;

const dictionary = getDictionary(localeOfPathname(Astro.url.pathname));

const LABEL_KEYS: Record<DirectContactId, keyof UiDictionary> = {
  whatsapp: 'ctaWhatsappLabel',
  email: 'ctaEmailLabel',
};
---

<ul class="flex flex-wrap gap-3">
  {links.map((link) => (
    <li>
      <Link
        href={link.href}
        class="inline-flex min-h-11 items-center gap-2 rounded border border-border px-3 py-2 text-text"
      >
        <Fragment set:html={CONTACT_CTA_ICONS[link.id]} />
        <span>{dictionary[LABEL_KEYS[link.id]]}</span>
      </Link>
    </li>
  ))}
</ul>
