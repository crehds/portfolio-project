---
import { getCollection } from 'astro:content';

import { featuredProjects } from '../../modules/projects/domain/featured-projects';
import { selectProjectsForLocale } from '../../modules/projects/domain/select-for-locale';
import { localeOfPathname } from '../../shared/i18n/paths';
import { getDictionary } from '../../shared/i18n/ui';

// Self-contained, like `Hero.astro`/`ContactCtas.astro`: derives its own locale and
// content. See T08 in odd/tasks/portfolio-astro-rebuild.md.
const locale = localeOfPathname(Astro.url.pathname);
const dictionary = getDictionary(locale);

const projectEntries = await getCollection('projects');
const projects = featuredProjects(
  selectProjectsForLocale(projectEntries, locale),
  { limit: 3 },
);
---

<section class="flex flex-col gap-6">
  <h2>{dictionary.featuredProjectsHeading}</h2>
  <ul
    data-testid="featured-projects-grid"
    class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
  >
    {projects.map(({ data }) => (
      <li class="flex flex-col gap-3 rounded border border-border p-4">
        <h3>{data.title}</h3>
        <p class="text-sm text-text-muted">{data.summary}</p>
        <ul class="flex flex-wrap gap-2 font-mono text-xs text-text-muted">
          {data.stack.map((tech) => (
            <li class="rounded border border-border px-2 py-0.5">{tech}</li>
          ))}
        </ul>
        <ul class="flex gap-4 text-sm">
          {data.links.live && (
            <li>
              <a href={data.links.live}>{dictionary.projectLiveLabel}</a>
            </li>
          )}
          {data.links.repo && (
            <li>
              <a href={data.links.repo}>{dictionary.projectRepoLabel}</a>
            </li>
          )}
        </ul>
      </li>
    ))}
  </ul>
</section>
