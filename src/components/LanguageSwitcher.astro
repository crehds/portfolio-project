---
import { LOCALES } from '../shared/i18n/locales';
import { LOCALE_NAMES } from '../shared/i18n/locale-names';
import { localeOfPathname, pathnameInLocale } from '../shared/i18n/paths';
import { getDictionary } from '../shared/i18n/ui';

// Self-contained: `Astro.url` reflects the current request regardless of where this
// component is rendered, so it needs no props from the page or layout.
const pathname = Astro.url.pathname;
const locale = localeOfPathname(pathname);
const dictionary = getDictionary(locale);
---

<nav aria-label={dictionary.languageSwitcherLabel}>
  <ul>
    {LOCALES.map((target) => (
      <li>
        {target === locale ? (
          <span aria-current="true">{LOCALE_NAMES[target]}</span>
        ) : (
          <a
            href={pathnameInLocale(pathname, target)}
            hreflang={target}
            lang={target}
          >
            {LOCALE_NAMES[target]}
          </a>
        )}
      </li>
    ))}
  </ul>
</nav>
