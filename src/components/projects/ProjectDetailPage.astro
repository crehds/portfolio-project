---
import { Picture } from 'astro:assets';
import { getEntry, render } from 'astro:content';

import { formatProjectDate } from '../../modules/projects/domain/format-project-date';
import { localeOfPathname, pathnameInLocale } from '../../shared/i18n/paths';
import { getDictionary } from '../../shared/i18n/ui';

// Self-contained, like the home page's sections: derives its own locale from the URL
// and takes only the resolved content entry's id as a prop. See T09 in
// odd/tasks/portfolio-astro-rebuild.md.
interface Props {
  /** The exact `<slug>/<locale>` content entry id `getStaticPaths` resolved for this
   * route (the locale it picked, which can be a fallback - see
   * `selectProjectsForLocale`). */
  entryId: string;
}

const { entryId } = Astro.props;
const locale = localeOfPathname(Astro.url.pathname);
const dictionary = getDictionary(locale);

const entry = await getEntry('projects', entryId);
if (!entry) {
  throw new Error(`Missing project entry "${entryId}".`);
}
const { data } = entry;
const { Content } = await render(entry);

const backHref = pathnameInLocale('/projects/', locale);
---

<article class="flex flex-col gap-6">
  {data.cover && (
    <Picture
      src={data.cover}
      formats={['avif', 'webp']}
      alt={`${dictionary.projectCoverAlt} ${data.title}`}
      width={896}
      height={560}
      loading="eager"
      class="w-full rounded object-cover"
    />
  )}
  <div class="flex max-w-[70ch] flex-col gap-4">
    <h1>{data.title}</h1>
    {data.role && <p class="text-text-muted">{data.role}</p>}
    <p>{data.summary}</p>
    <p class="font-mono text-sm text-text-muted">
      {dictionary.projectLastUpdatedLabel}:{' '}
      {formatProjectDate(data.date, locale)}
    </p>
    {data.stack.length > 0 && (
      <ul class="flex flex-wrap gap-2 font-mono text-xs text-text-muted">
        {data.stack.map((tech) => (
          <li class="rounded border border-border px-2 py-0.5">{tech}</li>
        ))}
      </ul>
    )}
    <ul class="flex gap-4 text-sm">
      {data.links.live && (
        <li>
          <a href={data.links.live}>{dictionary.projectLiveLabel}</a>
        </li>
      )}
      {data.links.repo && (
        <li>
          <a href={data.links.repo}>{dictionary.projectRepoLabel}</a>
        </li>
      )}
    </ul>
    <div class="prose flex flex-col gap-4">
      <Content />
    </div>
    <p>
      <a href={backHref}>&larr; {dictionary.projectsBackLabel}</a>
    </p>
  </div>
</article>
