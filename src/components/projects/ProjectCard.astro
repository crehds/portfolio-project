---
import { Picture } from 'astro:assets';

import { coverAltText } from '../../modules/projects/domain/cover-alt-text';
import type { LocalizedProject } from '../../modules/projects/domain/select-for-locale';
import type { Locale } from '../../shared/i18n/locales';
import { pathnameInLocale } from '../../shared/i18n/paths';
import { getDictionary } from '../../shared/i18n/ui';
import Link from '../Link.astro';

interface Props {
  project: LocalizedProject;
  /** The page's own locale - not necessarily `project.locale`: a project can render
   * with fallback-locale `data` while the surrounding page (and therefore this card's
   * own UI strings and link target) stays in the requested locale. */
  locale: Locale;
  /** Whether to render the cover image, when the project has one. Defaults to `true`
   * for the dedicated projects list; the home page's featured cards pass `false` so the
   * hero photo stays the only `<img>` on that page (see e2e/home.spec.ts's "the hero
   * photo has localized alt text..." test, which locates it as `main img` and expects
   * exactly one). */
  showCover?: boolean;
  /** The card title's heading level: 3 under a section heading (the home page's featured
   * list, the default), 2 straight under the page's `<h1>` (the projects list). A level
   * skipped fails Lighthouse's `heading-order` audit. */
  headingLevel?: 2 | 3;
}

const { project, locale, showCover = true, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const { data } = project;
const dictionary = getDictionary(locale);
const href = pathnameInLocale(`/projects/${project.slug}/`, locale);

// The whole card opens the project page: the title's link is stretched over the card
// through its `::after` box, so there is still one link to the project (one tab stop, one
// name for a screen reader) and no script. The live site and repository links are
// positioned above that box, so they keep working as links of their own.
//
// Under the pointer (or holding the focus) the card gets a thicker accent frame, the
// `surface` background and an underlined title. The two links look like buttons and
// fill with the accent color, and the title drops its underline while the pointer is on
// one of them, so it is clear which of the two a click will follow.
const actionClass =
  'relative z-10 inline-block rounded border border-accent px-3 py-1 font-medium transition-colors hover:bg-accent hover:text-bg focus-visible:bg-accent focus-visible:text-bg';
---

<li class="group relative flex flex-col gap-3 rounded border border-border p-4 transition focus-within:border-accent focus-within:bg-surface focus-within:ring-2 focus-within:ring-accent hover:border-accent hover:bg-surface hover:ring-2 hover:ring-accent">
  {showCover && data.cover && (
    <Picture
      src={data.cover}
      formats={['avif', 'webp']}
      alt={coverAltText(data.title, locale)}
      width={640}
      height={400}
      loading="lazy"
      decoding="async"
      class="w-full rounded object-cover"
    />
  )}
  <Heading>
    <a
      href={href}
      class="decoration-2 underline-offset-4 group-hover:underline group-has-[[data-card-action]:hover]:no-underline after:absolute after:inset-0 after:rounded"
    >
      {data.title}
    </a>
  </Heading>
  <p class="text-sm text-text-muted">{data.summary}</p>
  {data.stack.length > 0 && (
    <ul class="flex flex-wrap gap-2 font-mono text-xs text-text-muted">
      {data.stack.map((tech) => (
        <li class="rounded border border-border px-2 py-0.5">{tech}</li>
      ))}
    </ul>
  )}
  <ul class="flex flex-wrap gap-3 text-sm">
    {data.links.live && (
      <li>
        <Link href={data.links.live} class={actionClass} data-card-action>
          {dictionary.projectLiveLabel}
        </Link>
      </li>
    )}
    {data.links.repo && (
      <li>
        <Link href={data.links.repo} class={actionClass} data-card-action>
          {dictionary.projectRepoLabel}
        </Link>
      </li>
    )}
  </ul>
</li>
