{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Pinned to the newest date the bundled Workers runtime actually supports, not to
  // today. wrangler ships an exact workerd/miniflare pair (see pnpm-lock.yaml); a later
  // date makes wrangler fall back with a warning instead of applying it. Bump this only
  // after a `pnpm update wrangler` brings in a newer runtime build (currently
  // workerd 1.20260925.1 / miniflare 5.20260925.0-alpha, both dated 2026-09-25).
  "compatibility_date": "2026-09-25",
  // global_fetch_strictly_public: makes the global fetch() always route as if the
  // request came from the public Internet, even for requests to this Worker's own zone
  // (they loop back through Cloudflare's edge instead of dispatching in-process, and may
  // re-enter this same Worker). Avoids surprising same-zone fast-path behavior.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "portfolio-project",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // The CV PDFs (`en.pdf` and `es.pdf`) live in this R2 bucket, not in git or in the
  // build, so the owner can replace one without a redeploy. `src/pages/cv/[locale].pdf.ts`
  // reads it through this binding. Wrangler does not create a missing bucket on deploy:
  // create it and upload both files first (docs/contact-setup.md).
  "r2_buckets": [
    {
      "binding": "CV_BUCKET",
      "bucket_name": "portfolio-cv",
    },
  ],
  // Worker Previews (`wrangler preview`) do not inherit bindings from the top level, so a
  // preview would have no CV bucket without this mirror. It points at the same bucket: the
  // CV is public, read-only content and there is no staging copy to keep apart.
  "previews": {
    "r2_buckets": [
      {
        "binding": "CV_BUCKET",
        "bucket_name": "portfolio-cv",
      },
    ],
  },
}
